{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch",
  "version": "0.7.5",
  "identifier": "dev.schaefer.dispatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dispatch",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 15
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../cli/dispatch.py": "cli/dispatch.py",
      "../cli/remote_screen.py": "cli/remote_screen.py",
      "../cli/activity.py": "cli/activity.py",
      "../cli/attachments.py": "cli/attachments.py",
      "../cli/insights_report.py": "cli/insights_report.py",
      "../cli/instructions.py": "cli/instructions.py",
      "../cli/session_reply.py": "cli/session_reply.py",
      "../cli/session_control.py": "cli/session_control.py",
      "../cli/serve.py": "cli/serve.py",
      "../cli/presence.py": "cli/presence.py",
      "../cli/edit-guard.py": "cli/edit-guard.py",
      "../cli/init_wizard.py": "cli/init_wizard.py",
      "../cli/updater.py": "cli/updater.py",
      "../cli/move.py": "cli/move.py",
      "../cli/summarize.py": "cli/summarize.py",
      "../cli/notify.py": "cli/notify.py",
      "../cli/semantic.py": "cli/semantic.py",
      "../cli/VERSION": "cli/VERSION",
      "../cli/board-sync.sh": "cli/board-sync.sh",
      "../cli/statusline-tee.sh": "cli/statusline-tee.sh",
      "../../agent/skills/task-board/": "agent/skills/task-board/",
      "../dist/": "dist/"
    }
  }
}
