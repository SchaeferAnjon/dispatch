#!/usr/bin/env python3
# Test-suite guard in front of /usr/bin/security: a test never reads or writes the real macOS keychain.
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", ".."))
from testkit import guard, shim
shim.run("security", guard.security_verdict)
