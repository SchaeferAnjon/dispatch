{
  "name": "dispatch",
  "private": true,
  "version": "0.9.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "build:ext": "vite build -c vite.idechat.config.ts --logLevel error && vite build -c vite.knowledge.config.ts --logLevel error && node ide-ext/scripts/build.mjs",
    "install:app": "bash scripts/install.sh",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s cli -p \"test_*.py\""
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@dicebear/core": "^9.4.3",
    "@dicebear/open-peeps": "^9.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
